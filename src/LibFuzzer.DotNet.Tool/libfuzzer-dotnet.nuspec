<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>libfuzzer-dotnet</id>
    <version>$version$</version>
    <authors>Metalnem</authors>
    <description>libFuzzer driver for SharpFuzz.</description>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/Metalnem/libfuzzer-dotnet</projectUrl>
    <repository type="git" url="https://github.com/Metalnem/libfuzzer-dotnet.git" />
    <tags>libfuzzer fuzzing sharpfuzz</tags>
    <packageTypes>
      <packageType name="DotnetTool" />
    </packageTypes>
  </metadata>
  <files>
    <file src="$settings$" target="tools/any/any/DotnetToolSettings.xml" />
  </files>
</package>
